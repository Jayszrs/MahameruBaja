{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "react-router": [
        "./src/lib/router-compat.tsx"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "tmp/next-order-qa/types/**/*.ts",
    "tmp/next-order-qa/dev/types/**/*.ts",
    "tmp/next-poster-qa/types/**/*.ts",
    "tmp/next-poster-qa/dev/types/**/*.ts",
    "tmp/next-review-final/types/**/*.ts",
    "tmp/next-review-final/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/App.tsx",
    "src/main.tsx",
    "src/routes.tsx",
    "src/layouts/RootLayout.tsx",
    "src/components/PageSEO.tsx",
    "tmp"
  ]
}
