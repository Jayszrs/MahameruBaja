NODE_ENV=development
DATABASE_URL=postgresql://mahameru:mahameru_dev@localhost:5432/mahameru_baja
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=mahameru-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_SITE_URL=https://mahamerubaja.com
NEXT_PUBLIC_WHATSAPP_MAIN=6281218052017

# Portal admin (isi di frontend/.env.local untuk development atau environment hosting)
ADMIN_EMAIL=
# Hash scrypt lama tetap diterima; setelah login ditingkatkan otomatis ke scrypt-v2.
ADMIN_PASSWORD_HASH=
# Secret acak minimal 32 byte, misalnya 48 byte acak yang diubah ke base64url.
ADMIN_SESSION_SECRET=

# Kosong = namespace lama, sehingga data CMS yang sudah ada tetap digunakan.
# Untuk pengujian Blob, gunakan namespace khusus dan akun fixture, jangan data client.
CMS_BLOB_PREFIX=

# Fastify: kosong berarti header proxy dari klien tidak dipercaya.
# Isi CIDR proxy yang benar-benar berada di depan API; port 4000 tetap lokal secara default.
TRUSTED_PROXY_CIDRS=
