{
  "name": "mahameru-baja-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "database"
  ],
  "scripts": {
    "dev": "concurrently -n WEB,API -c cyan,magenta \"npm run dev -w @mahameru/frontend\" \"npm run dev -w @mahameru/backend\"",
    "dev:web": "npm run dev -w @mahameru/frontend",
    "dev:api": "npm run dev -w @mahameru/backend",
    "build": "npm run build -w @mahameru/database && npm run build -w @mahameru/backend && npm run build -w @mahameru/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @mahameru/database",
    "db:migrate": "npm run db:migrate -w @mahameru/database",
    "db:studio": "npm run db:studio -w @mahameru/database",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up --build",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0"
  }
}
